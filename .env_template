UMLS_API_KEY = None
UMLS_BASE = "https://uts-ws.nlm.nih.gov/rest"

LLM_API = "http://localhost:11434/api/chat"
MODEL = "gpt-oss:20b"

# Langfuse tracing (self-hosted, see docker/langfuse/) — keys must match
# LANGFUSE_INIT_PROJECT_* in docker/langfuse/.env
# 127.0.0.1 (not localhost): the Docker port binding is IPv4-only, and another
# dev server on the IPv6 wildcard can shadow "localhost:3000"
LANGFUSE_HOST = "http://127.0.0.1:3000"
LANGFUSE_PUBLIC_KEY = "pk-lf-..."
LANGFUSE_SECRET_KEY = "sk-lf-..."

# Default trace redaction mode for the pipeline CLI (on|off)
REDACTION = "off"
PIPELINE_VERSION = "0.2.0"
